{
  "name": "bereich-b",
  "version": "1.0.0",
  "description": "Bereich B CMS (Payload v3)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate.ts",
    "dev": "pnpm generate:importmap && pnpm migrate && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "pnpm migrate && rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "graphql": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload-graphql generate:schema",
    "typecheck": "pnpm generate:importmap && tsc --noEmit",
    "lint": "pnpm run lint:fix && pnpm run prettier:fix",
    "lint:check": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix --report-unused-disable-directives --max-warnings 0",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts",
    "test:unit:coverage": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts --coverage",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed": "pnpm migrate && cross-env SKIP_IMPORTERS=true NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env src/dataseeder/main.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@sentry/nextjs": "10.76.1",
    "@slate-serializers/html": "2.1.6",
    "@supabase/postgrest-js": "1.19.4",
    "@tanstack/react-query": "5.66.9",
    "@turf/turf": "7.0.0-alpha.2",
    "@types/geojson": "7946.0.16",
    "@types/lodash": "4.14.196",
    "@types/node-cron": "3.0.11",
    "@types/proj4": "2.5.5",
    "cheerio": "1.2.0",
    "clsx": "2.0.0",
    "cross-env": "7.0.3",
    "dataloader": "2.2.3",
    "date-fns": "^4.1.0",
    "domutils": "3.1.0",
    "dotenv": "16.4.7",
    "fast-xml-parser": "5.12.0",
    "geojson": "0.5.0",
    "graphql": "16.13.0",
    "html-entities": "2.5.2",
    "import-in-the-middle": "2.0.6",
    "lodash": "4.18.0",
    "next": "16.4.5",
    "node-cron": "3.0.3",
    "osmtogeojson": "3.0.0-beta.5",
    "overpass-ts": "4.3.8",
    "payload": "3.90.2",
    "proj4": "2.10.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.5.0",
    "require-in-the-middle": "8.0.1",
    "sharp": "0.35.5",
    "temporal-polyfill": "0.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.1",
    "@payloadcms/graphql": "3.90.2",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "22.19.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "28.0.0",
    "minimist": "^1.2.8",
    "mongodb": "^7.1.0",
    "postcss": "8.5.6",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.12",
    "webpack": "5.104.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  }
}
