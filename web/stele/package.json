{
  "name": "stele",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "graphql": "codegen",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:fix && pnpm run prettier:fix",
    "lint:check": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix --report-unused-disable-directives --max-warnings 0",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@kommunalapp/expressions": "workspace:^",
    "@kommunalapp/graphql-client": "workspace:^",
    "@radix-ui/react-dialog": "1.1.15",
    "@sentry/react": "10.42.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "graphql": "16.13.0",
    "graphql-tag": "2.12.6",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-datepicker": "9.1.0",
    "react-dom": "19.2.7",
    "react-icons": "5.4.0",
    "react-leaflet": "5.0.0",
    "react-leaflet-cluster": "4.1.3",
    "react-router": "7.18.2",
    "tailwind-merge": "1.14.0",
    "tailwind-variants": "0.1.20",
    "urql": "4.0.5",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@kommunal/linting": "workspace:^",
    "@kommunal/tsconfig": "workspace:*",
    "@kommunalapp/codegen": "workspace:^",
    "@sentry/vite-plugin": "2.16.1",
    "@storybook/react-vite": "10.6.3",
    "@types/leaflet": "1.9.21",
    "@types/leaflet.markercluster": "1.5.5",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.2.3",
    "eslint": "9.39.3",
    "eslint-plugin-storybook": "10.6.3",
    "prettier": "3.0.0",
    "storybook": "10.6.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "prettier": "@kommunal/linting/prettier"
}
