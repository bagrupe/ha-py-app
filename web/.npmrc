hoist-pattern[]=*
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=tailwindcss
# react-email and related packages do not handle the hoisting of their dependencies well
public-hoist-pattern[]=react-email
public-hoist-pattern[]=@react-email/components
# mongoose-aggregate-paginate-v2 requires('mongoose') without declaring it as a dependency
public-hoist-pattern[]=mongoose
# pino requires('pino-pretty') without declaring it as a dependency
public-hoist-pattern[]=pino-pretty
# @payloadcms/graphql CLI requires minimist without declaring it as a dependency
public-hoist-pattern[]=minimist
# @sentry/nextjs OTel instrumentation needs these resolvable in standalone + pnpm monorepos
public-hoist-pattern[]=*import-in-the-middle*
public-hoist-pattern[]=*require-in-the-middle*
