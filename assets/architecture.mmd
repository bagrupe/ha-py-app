%%{ init: { 'flowchart': { 'curve': 'step' } } }%%
flowchart TB
    %% ------------------------------
    %% STYLING DEFINITIONS
    %% ------------------------------
    classDef actor fill:#fff,stroke:#000,stroke-width:2px;
    classDef green fill:#d5e8d4,stroke:#82b366,color:#000;
    classDef blue fill:#dae8fc,stroke:#6c8ebf,color:#000;
    classDef orange fill:#ffe6cc,stroke:#d79b00,color:#000;
    classDef yellow fill:#fff2cc,stroke:#d6b656,color:#000;
    classDef db fill:#ffffff,stroke:#000,stroke-width:1px,color:#000;
    classDef ext fill:#f5f5f5,stroke:#666666,color:#000;

    %% ------------------------------
    %% LAYER 1: ACTORS
    %% ------------------------------
    subgraph Users [ ]
        direction LR
        User1([Gemeinde-Mitarbeiter]):::actor
        User2([Bürger]):::actor
    end

    %% ------------------------------
    %% LAYER 2: CLIENT APPLICATIONS
    %% ------------------------------
    subgraph Clients [ ]
        direction LR
        Backoffice[Backoffice]:::green
        App[App]:::blue
    end

    User1 --> Backoffice
    User2 --> App

    %% ------------------------------
    %% LAYER 3: CORE SERVICES (Side-by-Side)
    %% ------------------------------
    subgraph Core_Services [ ]
        direction LR

        %% CMS Container (Left side)
        subgraph CMS_Container [ ]
            direction TB
            Payload[Inhaltspflege / <br/>Payload CMS]:::orange
            MongoDB[(Mongo Db)]:::db
            Payload --> MongoDB
        end

        %% Backend Container (Right side)
        subgraph Backend_Container [ ]
            direction TB
            Backend[Backend]:::yellow
            Postgres[(PostgreSQL)]:::db
            Backend --> Postgres
        end
    end

    %% Client to Core Connections
    Backoffice -.-> Payload
    Backoffice -- GraphQL --> Backend
    App -- GraphQL --> Backend

    %% Connection between the two core services
    Backend -- GraphQL ---> Payload

    %% ------------------------------
    %% LAYER 4: EXTERNAL SERVICES (Bottom)
    %% ------------------------------
    subgraph External_APIs [ ]
        direction LR

        %% Grouping these invisibly to keep similar items near each other
        subgraph Group_CMS_Dests [ ]
            direction TB
            DestOne[Destination One /<br/>Niedersachsen Hub]:::ext
            NOLIS[NOLIS]:::ext
            RSS[RSS]:::ext
        end

        subgraph Group_Shared [ ]
             direction TB
             Mail[Mail-Server]:::ext
             Influx[Sensoren InfluxDb /<br/>ortliebweb]:::ext
        end

        subgraph Group_Backend_Dests [ ]
            direction TB
            KAW[KAW Hameln<br/>Abfuhrkalender]:::ext
            Gotenberg[Gotenberg]:::ext
            Gov[GovManager]:::ext
            Firebase[Firebase<br/>Push-Notifications]:::ext
        end
    end

    %% Core to External Connections
    Payload -- HTTP ---> DestOne
    Payload -- HTTP ---> NOLIS
    Payload -- HTTP ---> RSS
    Payload -- SMTP ----> Mail
    Payload -- REST ----> Influx

    Backend -- SMTP ----> Mail
    Backend -- REST ---> KAW
    Backend -- REST ---> Gotenberg
    Backend -- REST ---> Gov
    Backend -- REST ---> Firebase

    %% ------------------------------
    %% STYLING APPLICATIONS
    %% ------------------------------
    %% Dashed borders for core containers
    style CMS_Container fill:none,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5
    style Backend_Container fill:none,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5

    %% Hide borders for structural grouping containers
    style Users fill:none,stroke:none
    style Clients fill:none,stroke:none
    style Core_Services fill:none,stroke:none
    style External_APIs fill:none,stroke:none
    style Group_CMS_Dests fill:none,stroke:none
    style Group_Shared fill:none,stroke:none
    style Group_Backend_Dests fill:none,stroke:none
