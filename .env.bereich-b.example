# Payload v3: single connection URL replaces MONGODB_URI + MONGODB_USERNAME/PASSWORD
DATABASE_URL=mongodb://REPLACE_ME:REPLACE_ME@mongodb/bereich-b?authSource=admin
PAYLOAD_SECRET=REPLACE_ME
# Shared secret for /internal/* routes; must match backend BereichB__InternalApiSecret
INTERNAL_API_SECRET=REPLACE_ME
PAYLOAD_API_KEY=REPLACE_ME
PAYLOAD_SUPERADMIN_EMAIL=payload_admin@example.com
PAYLOAD_SUPERADMIN_PASSWORD=REPLACE_ME
OPENWEATHER_API_KEY=REPLACE_ME
ENABLE_DATASEEDER=false
# Demo-Daten des LageHelfer-Mandanten (KRL Weserbergland); nur auf Dev/Staging aktivieren
ENABLE_LAGEHELFER_SEED=false
# Kommune in der Inhaltspflege (muss zu kommune.id in backend seed.json passen)
# LAGEHELFER_KOMMUNE_ID=84a06067-dc9e-46d0-b60a-8258cf7c1ce7
# LAGEHELFER_KOMMUNE_NAME=Kooperative Regionalleitstelle Weserbergland
# LAGEHELFER_REGIONALSCHLUESSEL=03252
# LAGEHELFER_DEFAULT_POSITION=51.9786,9.4264
# Payload v3: replaces PAYLOAD_PUBLIC_SERVER_URL
NEXT_PUBLIC_SERVER_URL=REPLACE_ME
MAPBOX_TOKEN=REPLACE_ME
VERANSTALTUNGEN_HAPY_DEST_ONE_KEY=REPLACE_ME
IKISS_HAPY_USERNAME=REPLACE_ME
IKISS_HAPY_PASSWORD=REPLACE_ME
NOLIS_HAPY_TOKEN=REPLACE_ME
HAPY_SENSOREN_POSTGREST_URL=REPLACE_ME
HAPY_SENSOREN_POSTGREST_TOKEN=REPLACE_ME
HAPY_SENSOREN_POSTGREST_TABLE=REPLACE_ME
HAPY_SENSOREN_POSTGREST_AGGREGATED_TABLE=REPLACE_ME
HAPY_SENSOREN_SYNC_WINDOW_HOURS=6

SENTRY_DSN=
