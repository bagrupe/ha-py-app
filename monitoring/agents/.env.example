# Copy to .env for manual deploys. Production secrets are injected via GitLab CI
# variable MONITORING_ENV_FILE (scoped per environment: staging, preprod, production).

# Postgres exporter — read-only monitoring user (see README.md for user setup)
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://monitoring:REPLACE_ME@postgres:5432/domain?sslmode=disable

# MongoDB exporter — read-only monitoring user (see README.md for user setup)
MONGODB_EXPORTER_URI=mongodb://monitoring:REPLACE_ME@mongodb:27017/admin?authSource=admin

# Host ports (defaults avoid conflict with stele on 8080)
CADVISOR_PORT=8081
POSTGRES_EXPORTER_PORT=9187
MONGODB_EXPORTER_PORT=9216
