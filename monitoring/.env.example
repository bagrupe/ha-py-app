# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME
GF_SERVER_ROOT_URL=https://monitoring.example.invalid/

# Grafana alert emails (Brevo SMTP)
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp-relay.brevo.com:587
GF_SMTP_USER=REPLACE_ME
GF_SMTP_PASSWORD=REPLACE_ME
GF_SMTP_FROM_ADDRESS=monitoring@example.com
GF_SMTP_FROM_NAME=Hameln Monitoring
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Pushgateway (cron job metrics from app VMs)
PUSHGATEWAY_PORT=9091

# Let's Encrypt (used for initial cert bootstrap command)
CERTBOT_EMAIL=REPLACE_ME

# On app GitLab environments (staging, preprod, production), MONITORING_ENV_FILE
# contains exporter settings — see monitoring/agents/.env.example.

# --- Blackbox probe targets ---
# Shared app ports (same on staging, preprod, production)
BACKEND_PORT=8080
BEREICH_B_PORT=3001
BEREICH_A_PORT=3000
STELE_PORT=8080

# Local development (docker-compose.local.yml sets LOCAL_APP_HOST=host.docker.internal by default)
LOCAL_APP_HOST=host.docker.internal
LOCAL_BACKEND_PORT=5000
LOCAL_BEREICH_B_PORT=3001
LOCAL_BEREICH_A_PORT=3000
# LOCAL_STELE_PORT=8080
# LOCAL_APP_DOMAIN=
# LOCAL_STELE_DOMAIN=

# Staging
STAGING_SERVER_IP=REPLACE_ME
STAGING_APP_DOMAIN=app.example.invalid
STAGING_STELE_DOMAIN=stele.example.invalid

# Pre-production
PREPROD_SERVER_IP=REPLACE_ME
PREPROD_APP_DOMAIN=
PREPROD_STELE_DOMAIN=

# Production
PRODUCTION_SERVER_IP=REPLACE_ME
PRODUCTION_APP_DOMAIN=
PRODUCTION_STELE_DOMAIN=
