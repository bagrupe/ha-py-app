# Keycloak + BundID — add these lines to the GitLab CI file variable DEPLOYMENT_ENV_FILE (staging).
# Passwords are examples only; use strong values in GitLab.

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=REPLACE_ME
KEYCLOAK_DB_NAME=keycloak

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME

# Shared password for bundid-saml-signing.p12 and bundid-saml-encryption.p12 on the server.
BUNDID_KEYSTORE_PASSWORD=REPLACE_ME

# Must match the value registered with BundID (see docker-compose.local.yml).
BUNDID_ORGANIZATION_DISPLAY_NAME=KommunalApp Hameln-Pyrmont

# Nginx public hostnames for deployment (see .env.nginx.example).
