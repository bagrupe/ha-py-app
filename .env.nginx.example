# Nginx reverse proxy — add these lines to the GitLab CI file variable DEPLOYMENT_ENV_FILE (per environment).
# Used by .gitlab/scripts/render_reverse_proxy.sh during deployment:start.
#
# Server: CI connects as deploy_user (ci/deployment.gitlab-ci.yml). That user must be in the
# Unix group lk-hameln-pyrmont to create/update ${MOUNT_POINT}/reverse-proxy.config.

# Public hostname for Bereich A + API + CMS (TLS cert path uses this name).
APP_DOMAIN=app.example.invalid

# Public hostname for the Infostele SPA.
STELE_DOMAIN=stele.example.invalid

# Keycloak routing (server blocks from docker/nginx/reverse-proxy.keycloak.conf.template).
# Optional — defaults to true when omitted (staging/production keep their own Keycloak).
# Set to false on environments that use another instance's Keycloak (e.g. preprod -> staging Keycloak):
# no server block, no certificate path and no upstream "keycloak" is rendered then.
# KEYCLOAK_PROXY_ENABLED=true

# Keycloak / BundID hostname (fixed for BundID registration; same on staging/preprod/prod).
# Optional — defaults to auth.example.invalid. Ignored when KEYCLOAK_PROXY_ENABLED=false.
# KEYCLOAK_HOSTNAME=auth.example.invalid

# Example values for other environments:
# preprod:  APP_DOMAIN=app.example.invalid  STELE_DOMAIN=stele.example.invalid
# production: APP_DOMAIN=app.example.invalid  STELE_DOMAIN=stele.example.invalid (or your prod stele host)
