{
  "realm": "kommunalapp",
  "enabled": true,
  "displayName": "Kommunal-App",
  "displayNameHtml": "Kommunal-App",
  "loginTheme": "kommunalapp",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "kommunalapp-mobile",
      "name": "KommunalApp Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "de.landkreis.hapy.app:/oauthredirect",
        "de.landkreis.hapy.app.staging:/oauthredirect",
        "de.landkreis.hapy.app.preprod:/oauthredirect",
        "http://localhost:*/oauthredirect",
        "https://auth.example.invalid/realms/kommunalapp/account/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "de.landkreis.hapy.app:/oauthredirect##de.landkreis.hapy.app.staging:/oauthredirect##de.landkreis.hapy.app.preprod:/oauthredirect##http://localhost:*/oauthredirect"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "kommunalapp-mobile-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kommunalapp-mobile",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "identity-provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "identity_provider",
            "jsonType.label": "String"
          }
        },
        {
          "name": "bundid-session-attributes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-bundid-sessionnote-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "bundid",
      "displayName": "BundID INT",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "singleSignOnServiceUrl": "https://int.id.bund.de/idp/profile/SAML2/POST/SSO",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:transient",
        "principalType": "ATTRIBUTE",
        "principalAttribute": "urn:oid:1.3.6.1.4.1.25484.494450.3",
        "entityId": "https://auth.example.invalid/bundid-sp",
        "wantAuthnRequestsSigned": "true",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "true",
        "validateSignature": "true",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "allowedClockSkew": "60",
        "signSpMetadata": "true",
        "useMetadataDescriptorUrl": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "bundid-bpk2-request",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:1.3.6.1.4.1.25484.494450.3",
        "attribute.name": "urn:oid:1.3.6.1.4.1.25484.494450.3",
        "attribute.required": "true",
        "session.attribute": "bpk2"
      }
    },
    {
      "name": "bundid-email",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-email-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:0.9.2342.19200300.100.1.3",
        "attribute.name": "urn:oid:0.9.2342.19200300.100.1.3",
        "attribute.required": "false",
        "session.attribute": "email"
      }
    },
    {
      "name": "bundid-vorname-request",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:2.5.4.42",
        "attribute.name": "urn:oid:2.5.4.42",
        "attribute.required": "false",
        "session.attribute": "vorname"
      }
    },
    {
      "name": "bundid-vorname-profile",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "urn:oid:2.5.4.42",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "bundid-nachname-request",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:2.5.4.4",
        "attribute.name": "urn:oid:2.5.4.4",
        "attribute.required": "false",
        "session.attribute": "nachname"
      }
    },
    {
      "name": "bundid-nachname-profile",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "attribute.name": "urn:oid:2.5.4.4",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "bundid-street",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:2.5.4.16",
        "attribute.name": "urn:oid:2.5.4.16",
        "attribute.required": "false",
        "session.attribute": "street"
      }
    },
    {
      "name": "bundid-postalcode",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:2.5.4.17",
        "attribute.name": "urn:oid:2.5.4.17",
        "attribute.required": "false",
        "session.attribute": "postalCode"
      }
    },
    {
      "name": "bundid-city",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:2.5.4.7",
        "attribute.name": "urn:oid:2.5.4.7",
        "attribute.required": "false",
        "session.attribute": "city"
      }
    },
    {
      "name": "bundid-country",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:1.2.40.0.10.2.1.1.225599",
        "attribute.name": "urn:oid:1.2.40.0.10.2.1.1.225599",
        "attribute.required": "false",
        "session.attribute": "country"
      }
    },
    {
      "name": "bundid-telephone-request",
      "identityProviderAlias": "bundid",
      "identityProviderMapper": "saml-bundid-session-attribute-idp-mapper",
      "config": {
        "attribute.oid": "urn:oid:2.5.4.20",
        "attribute.name": "urn:oid:2.5.4.20",
        "attribute.required": "false",
        "session.attribute": "telephoneNumber"
      }
    }
  ]
}
