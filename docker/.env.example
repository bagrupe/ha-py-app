# Copy to docker/.env to change the local container ports or the Compose project name.
# Every value is optional; unset values fall back to the defaults shown.
# The project name prefixes container names, volumes and the network, so a different name gives a separate set of containers and data.

# COMPOSE_PROJECT_NAME=hameln

# POSTGRES_PORT=5432
# POSTGRES_ARCHIVE_PORT=5434
# MONGO_PORT=27017
# GOTENBERG_PORT=3002
# OBJECT_STORAGE_PORT=9000
# OBJECT_STORAGE_CONSOLE_PORT=9002
# KEYCLOAK_PORT=8081
# KEYCLOAK_MANAGEMENT_PORT=9001
