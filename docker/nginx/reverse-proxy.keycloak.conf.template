# Optional fragment: appended to reverse-proxy.conf.template by .gitlab/scripts/render_reverse_proxy.sh
# unless KEYCLOAK_PROXY_ENABLED=false (e.g. preprod, which uses the staging Keycloak).

# --- Keycloak (BundID Identity Broker, OIDC for app/backend) ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${KEYCLOAK_HOSTNAME};

    ssl_certificate /etc/letsencrypt/live/${KEYCLOAK_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KEYCLOAK_HOSTNAME}/privkey.pem;

    add_header 'Content-Security-Policy' 'upgrade-insecure-requests';

    # SAML POST bindings can exceed default nginx proxy buffers.
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location / {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${KEYCLOAK_HOSTNAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    add_header 'Content-Security-Policy' 'upgrade-insecure-requests';
}
