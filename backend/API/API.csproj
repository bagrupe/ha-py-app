<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1904</WarningsAsErrors>
    <UserSecretsId>b679c14e-d37f-4417-b031-76304fb4566e</UserSecretsId>
    <NoWarn>CS0693</NoWarn>
    <!-- See https://github.com/dotnet/aspnetcore/issues/50836#issuecomment-1812985321 -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Seeders\LageHelfer\Data\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Seeders\LageHelfer\Data\**\*.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="Azure.Core" Version="1.38.0" />
    <PackageReference Include="brevo_csharp" Version="1.1.2" />
    <PackageReference Include="CsvHelper" Version="32.0.3" />
    <PackageReference Include="FirebaseAdmin" Version="2.4.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="Flurl" Version="4.0.0" />
    <PackageReference Include="GeoJSON.Net" Version="1.2.19" />
    <PackageReference Include="GeoJSON.Text" Version="1.0.2" />
    <PackageReference Include="HotChocolate" Version="13.9.16" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="13.9.16" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Authorization" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Data" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Stitching" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Types.Filters" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Types.NodaTime" Version="13.9.16" />
    <PackageReference Include="HotChocolate.Types.Sorting" Version="13.9.16" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Spatial" Version="7.20.0" />
    <PackageReference Include="Mime-Detective" Version="23.10.1" />
    <PackageReference Include="MimeTypesMap" Version="1.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NetEscapades.Configuration.Validation" Version="2.0.0" />
    <PackageReference Include="NGuid" Version="0.2.0" />
    <PackageReference Include="NodaTime" Version="3.2.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="9.0.3" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="ProjNET" Version="2.0.0" />
    <PackageReference Include="Quartz.AspNetCore" Version="3.7.0" />
    <PackageReference Include="Riok.Mapperly" Version="3.3.0" />
