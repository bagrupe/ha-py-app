{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Environment": {
    "Name": "Production"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Domain": "Server=127.0.0.1;Port=5432;Database=db;UserId=admin;Password=password;Enlist=false",
    "Archive": "Server=127.0.0.1;Port=5434;Database=archive;UserId=archive;Password=archive-password;Enlist=false"
  },
  "Web": {
    "BaseUrl": "http://localhost:3000"
  },
  "Prozess": {
    "NachrichtMaxLength": 2000
  },
  "JWT": {
    "Key": "",
    "Issuer": "Kommunal App"
  },
  "PmPayment": {
    "Url": "https://payment-test.govconnect.de",
    "AGS": "",
    "Procedure": "KommunalApp",
    "Salt": "",
    "NotificationUrl": "https://example.com/api/PmPaymentNotification",
    "RedirectHost": "localhost"
  },
  "GovManager": {
    "RestUrl": "https://govmanager.govconnect.de/rest/public/lieferungen/public/upload/<vorgangs-typ>?mandant=<mandanten-schluessel>&vorgang=<vorgang-schluessel>",
    "Username": "set me with dotnet user-secrets",
    "Password": "set me with dotnet user-secrets",
    "ResponseKey": "set me with dotnet user-secrets"
  },
  "EMail": {
    "Host": "localhost",
    "Port": 1025,
    "User": "user",
    "Password": "password",
    "EnableSsl": "false",
    "From": "noreply@example.com",
    "FromDisplayName": "KommunalApp"
  },
  "Gotenberg": {
    "Url": "http://localhost:3002"
  },
  "KawHameln": {
    "RestUrl": "http://om.kaw-hameln.de/WasteManagementHameln/WasteManagementServiceServlet"
  },
  "Sentry": {
    "Dsn": ""
  },
  "RateLimit": {
    "IgnoreRateLimit": false,
    "SmsRequestWindowMinutes": 30,
    "SmsMaxRequestsPerWindow": 3,
    "SmsValidationWindowMinutes": 15,
    "SmsMaxFailedAttempts": 5,
    "SmsVerificationLockMinutes": 15,
    "SmsResendCooldownSeconds": 30
  },
  "MobileApp": {
    "MinimumCompatibleAppVersion": "2.0.0"
  },
  "Firebase": {
    "CredentialPath": "./kommunalapp-service-account.json"
  },
  "Ehrenamtsbank": {
    "ACCEPT_MASTER_CODE": false,
    "PhoneNumberSalt": "set me with dotnet user-secrets",
    "EintragSkipReview": true
  },
  "BundId": {
    "Enabled": true,
    "KeycloakAuthority": "http://localhost:8081/realms/kommunalapp",
    "Audience": "kommunalapp-mobile",
    "IdentityProviderAlias": "bundid",
    "RequireBundIdIdentityProviderClaim": true
  },
  "Brevo": {
    "ApiKey": "",
    "Sender": "KommunalApp",
    "MessageTemplate": "Der Code für ihre Anmeldung lautet {code}"
  }
}
