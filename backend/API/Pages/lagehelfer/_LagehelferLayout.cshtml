@{
    var step = ViewData["FlowStep"] as int?;
    var label = ViewData["FlowHeader"] as string ?? TempData.Peek("LagehelferTitel") as string;
}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@ViewData["Title"] – Lagehelfer</title>
  <link rel="stylesheet" href="~/lagehelfer/styles.css" asp-append-version="true">
  <link rel="stylesheet" href="~/lagehelfer/app.css" asp-append-version="true">
  @await RenderSectionAsync("Head", required: false)
  <link rel="stylesheet" href="~/lagehelfer/meldeflow.css" asp-append-version="true">
</head>
<body>
<div class="app">

  @if (ViewData["FlowHideHeader"] is not true && (step.HasValue || label is not null)) {
    <header class="flow-header">
      @if (step is { } current) {
        <span class="flow-meta" data-flow-step>Schritt @current von 4</span>
        <progress class="flow-progress" aria-label="Fortschritt der Meldung" max="4" value="@current"></progress>
      } else {
        <div class="flow-header__row">
          <strong>Lagehelfer</strong>
          <span class="flow-badge">@label</span>
        </div>
      }
    </header>
  }
  <main class="app-content">
    <div class="view">
      @RenderBody()
    </div>
  </main>

  @if (ViewData["HideBackFooter"] is not true) {
    <footer class="lagehelfer-footer">
      @await RenderSectionAsync("FooterActions", required: false)
      <a class="lagehelfer-footer__back" asp-page="/lagehelfer/Index" asp-route-kommuneId="@(ViewData["KommuneId"])">Zurück</a>
      <span class="lagehelfer-footer__emergency">Lebensgefahr? <a class="flow-emergency-link" href="tel:112">112 anrufen</a></span>
    </footer>
  }
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
