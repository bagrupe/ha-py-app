@{
  var activeTab = ViewData["Tab"] as string;
  var kommuneId = ViewData["KommuneId"];
}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@ViewData["Title"] – Lagehelfer</title>
  <link rel="stylesheet" href="~/lagehelfer/styles.css" asp-append-version="true">
  <link rel="stylesheet" href="~/lagehelfer/app.css" asp-append-version="true">
  @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app">

  <main class="app-content">
    <div class="view">
      @RenderBody()
    </div>
  </main>

  <nav class="tab-bar" aria-label="Hauptnavigation">
    <a class="tab" asp-page="/lagehelfer/Index" asp-route-kommuneId="@kommuneId" aria-current="@(activeTab == "start" ? "page" : null)">
      <span class="tab__icon icon-slot" aria-hidden="true"></span>
      Start
    </a>
    <a class="tab" asp-page="/lagehelfer/GefahrCheck" asp-route-kommuneId="@kommuneId" aria-current="@(activeTab == "melden" ? "page" : null)">
      <span class="tab__icon icon-slot" aria-hidden="true"></span>
      Melden
    </a>
  </nav>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
