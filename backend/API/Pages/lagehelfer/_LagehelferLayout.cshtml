<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>@ViewData["Title"] – Lagehelfer</title>
  <link rel="stylesheet" href="~/lagehelfer/styles.css" asp-append-version="true">
  <link rel="stylesheet" href="~/lagehelfer/app.css" asp-append-version="true">
  @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app">

  <main class="app-content">
    <div class="view">
      @RenderBody()
    </div>
  </main>

  @if (ViewData["HideBackFooter"] is not true) {
    <footer class="lagehelfer-footer">
      <a class="lagehelfer-footer__back" asp-page="/lagehelfer/Index" asp-route-kommuneId="@(ViewData["KommuneId"])">Zurück</a>
      @await RenderSectionAsync("FooterActions", required: false)
    </footer>
  }
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
