@page
@model IndexModel
@{
  ViewData["FlowHideHeader"] = true;
  ViewData["Title"] = "Start";
  ViewData["HideBackFooter"] = true;
}

<section>
  <div class="section-title"><h2>Aktuelle Lagen</h2></div>
  @if (Model.Lagen.Count == 0) {
    <div class="notice notice--info" role="status" style="margin-top:8px">
      <div>
        <strong>Aktuell ist keine Lage aktiv.</strong><br>
        Meldungen sind deshalb gerade nicht möglich. Bei akuter Gefahr wählen Sie den Notruf 112.
      </div>
    </div>
    <a class="btn btn--danger btn--block" href="tel:112" style="margin-top:8px">112 anrufen</a>
  } else {
    <div class="card" style="margin-top:8px"><ul class="list">
      @foreach (var lage in Model.Lagen) {
        <li class="list__item">
          <div class="list__main">
            <strong>@lage.Title</strong>
            <span class="list__sub">@string.Join(", ", lage.Gebiete.Select(g => g.Name))</span>
          </div>
          @if (!string.IsNullOrWhiteSpace(lage.WarningText)) {
            <span class="badge badge--work">@lage.WarningText</span>
          }
          <a class="btn btn--primary" asp-page="Erklaerung" asp-route-kommuneId="@Model.KommuneId" asp-route-lageId="@lage.Id">Vorfall melden</a>
        </li>
      }
    </ul></div>
  }
</section>
