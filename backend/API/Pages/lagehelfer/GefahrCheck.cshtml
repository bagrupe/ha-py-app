@page "/lagehelfer/gefahr-check"
@model GefahrCheckModel
@{
  ViewData["Title"] = "Notfallprüfung";
  ViewData["Tab"] = "melden";
}

<section>
  <div class="section-title"><h2>Bevor du eine Meldung machst</h2></div>
  <div class="card" style="margin-top:8px">
    <form class="card__body" style="gap:14px" method="post">
      <fieldset class="choice">
        <legend>Ist ein Mensch in unmittelbarer Lebensgefahr?</legend>
        <div class="choice__row">
          <button class="choice__opt choice__opt--danger" type="submit" name="answer" value="ja"><span>Ja</span></button>
          <button class="choice__opt" type="submit" name="answer" value="nein"><span>Nein</span></button>
        </div>
      </fieldset>
      @if (Model.DangerReported) {
        <div class="notice notice--danger" role="alert">
          <strong>Bitte rufe jetzt den Notruf 112 an. Nutze dieses Formular nicht bei akuter Lebensgefahr.</strong>
          <a class="btn btn--danger btn--block" href="tel:112">112 anrufen</a>
        </div>
      } else {
        <p class="card__meta" role="status" aria-live="polite">Bitte beantworte die Frage, um fortzufahren.</p>
        <a class="btn btn--ghost btn--block" asp-page="Index" asp-route-kommuneId="@Model.KommuneId">Zurück</a>
      }
    </form>
  </div>
</section>
