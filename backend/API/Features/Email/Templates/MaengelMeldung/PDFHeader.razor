@using API.Features.PdfGenerator
<div class="page-header" style="width:100%; text-align:left; font-size:16px; margin-right:0.39in; margin-left:0.39in; display: flex; gap: 16px; align-items: center">
    <span style="flex: 1;"><img src="@LogoUrl" style="height: 40px; margin-right:10px;"/></span>
    <span style="display: flex; flex-direction: column; align-items: center;">
        <span>@ProzessName</span>
        @if (ZustaendigkeitLine() is { } zustaendigkeitLine)
        {
            <span style="font-size: 11px;">@zustaendigkeitLine</span>
        }
    </span>
    <span style="opacity: 50%; font-size: 10px; flex: 1; text-align: right;">@AusfuehrungId</span>
</div>

@code {
    [Parameter, EditorRequired]
    public required string ProzessName { get; set; }

    [Parameter, EditorRequired]
    public required Guid AusfuehrungId { get; set; }

    [Parameter]
    public string? LogoUrl { get; set; }

    [Parameter]
    public PdfZustaendigkeit Zustaendigkeit { get; set; } = PdfZustaendigkeit.None;

    private string? ZustaendigkeitLine() {
        if (Zustaendigkeit.Dienstleister is { } dienstleister) {
            return $"Dienstleister: {dienstleister}";
        }

        string?[] parts = [
            Zustaendigkeit.Organisationseinheit is { } organisationseinheit ? $"Organisationseinheit: {organisationseinheit}" : null,
            Zustaendigkeit.Abteilung is { } abteilung ? $"Abteilung: {abteilung}" : null,
        ];
        var line = string.Join(" · ", parts.OfType<string>());
        return line.Length > 0 ? line : null;
    }
}
